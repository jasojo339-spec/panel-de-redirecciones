# =====================================================================
#  Plantilla de configuración — Panel de Redirecciones
#
#  En la máquina local (desarrollo) ya existe un .env.
#  Al subir el proyecto a un servidor, copiá esta plantilla y completala:
#
#      cp .env.example .env
#      chmod 600 .env          # que solo root pueda leerlo
#      nano .env               # poné una contraseña FUERTE
#
#  ⚠ Este archivo NO se sube al servidor ni se commitea a git: el .env
#    real contiene secretos. Este .env.example sí puede viajar.
# =====================================================================

# Credenciales del panel /admin
# (la contraseña de prueba "4dm1n!" es para desarrollo: en un servidor
#  expuesto a internet usá una contraseña larga y distinta)
ADMIN_USER=admin
ADMIN_PASSWORD=pon-aqui-una-clave-fuerte

# Solo para correr en local con `npm run dev`:
# en Docker la URL la fija el Dockerfile (file:/app/data/dev.db).
# DATABASE_URL="file:./dev.db"
