/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos SQLite (se crea con las migraciones)
/prisma/dev.db
/prisma/dev.db-journal

# base de datos dentro de Docker (bind mount del contenedor)
/data/

# respaldo del panel en HTML simple
index-panel-v1.html.bak
