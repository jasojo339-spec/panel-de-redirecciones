<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel de Redirecciones</title>
<style>
  :root {
    --bg: #0f172a;
    --bg-2: #1e293b;
    --card: #1e293b;
    --card-hover: #273449;
    --border: #334155;
    --text: #e2e8f0;
    --muted: #94a3b8;
    --accent: #38bdf8;
    --accent-2: #818cf8;
    --ok: #4ade80;
    --radius: 14px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    background: radial-gradient(1200px 600px at 10% -10%, #1e3a5f 0%, transparent 55%),
                radial-gradient(900px 500px at 110% 10%, #312e81 0%, transparent 50%),
                var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 32px 20px 60px;
  }

  .container { max-width: 1100px; margin: 0 auto; }

  header { text-align: center; margin-bottom: 34px; }

  header h1 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: .5px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  header p { color: var(--muted); margin-top: 10px; font-size: 1rem; }

  .toolbar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 28px;
  }

  .search {
    flex: 1 1 320px;
    max-width: 460px;
    position: relative;
  }

  .search input {
    width: 100%;
    padding: 12px 16px 12px 42px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-size: .95rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }

  .search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, .15);
  }

  .search::before {
    content: "🔍";
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    opacity: .7;
    font-size: .9rem;
  }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }

  .chip {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--muted);
    font-size: .85rem;
    cursor: pointer;
    transition: all .18s;
  }

  .chip:hover { color: var(--text); border-color: var(--accent); }

  .chip.active {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    color: #0b1220;
    border-color: transparent;
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition: transform .18s, border-color .18s, background .18s, box-shadow .18s;
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    opacity: 0;
    transition: opacity .18s;
  }

  .card:hover {
    transform: translateY(-4px);
    background: var(--card-hover);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .35);
  }

  .card:hover::after { opacity: 1; }

  .card-top { display: flex; align-items: center; gap: 12px; }

  .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: #0b1220;
    flex-shrink: 0;
  }

  .card h3 { font-size: 1.05rem; line-height: 1.25; }

  .card p { color: var(--muted); font-size: .87rem; line-height: 1.45; flex: 1; }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: .78rem;
    color: var(--muted);
    border-top: 1px dashed var(--border);
    padding-top: 10px;
  }

  .tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(129, 140, 248, .15);
    color: var(--accent-2);
    border: 1px solid rgba(129, 140, 248, .3);
  }

  .go { color: var(--accent); font-weight: 600; }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 60px 10px;
    display: none;
  }

  .count { text-align: center; color: var(--muted); font-size: .85rem; margin-top: 26px; }

  footer {
    margin-top: 44px;
    text-align: center;
    color: var(--muted);
    font-size: .8rem;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }

  @media (max-width: 520px) {
    .grid { grid-template-columns: 1fr; }
    body { padding: 24px 14px 40px; }
  }
</style>
</head>
<body>
<div class="container">

  <header>
    <h1>Panel de Redirecciones</h1>
    <p>Selecciona el destino al que quieres acceder</p>
  </header>

  <div class="toolbar">
    <div class="search">
      <input type="text" id="search" placeholder="Buscar destino..." autocomplete="off">
    </div>
    <div class="filters" id="filters"></div>
  </div>

  <main class="grid" id="grid"></main>
  <div class="empty" id="empty">No se encontraron destinos.</div>

  <div class="count" id="count"></div>

  <footer>
    Panel de redirecciones &copy; <span id="year"></span> &mdash; Haz clic en una tarjeta para abrir el destino
  </footer>

</div>

<script>
/* =========================================================================
   CONFIGURACIÓN: agrega aquí cada destino que necesites.
   Campos:
     name  -> nombre del destino
     url   -> dirección completa (https://...)
     desc  -> descripción corta
     cat   -> categoría (aparece como filtro)
     icon  -> emoji o inicial para el ícono
     color -> color de fondo del ícono (cualquier CSS válido)
   ========================================================================= */
const DESTINOS = [
  {
    name: "Google",
    url: "https://www.google.com",
    desc: "Buscador principal.",
    cat: "Buscadores",
    icon: "G",
    color: "#4285F4"
  },
  {
    name: "YouTube",
    url: "https://www.youtube.com",
    desc: "Plataforma de videos.",
    cat: "Entretenimiento",
    icon: "▶",
    color: "#FF0000"
  },
  {
    name: "GitHub",
    url: "https://github.com",
    desc: "Repositorios de código.",
    cat: "Desarrollo",
    icon: "{ }",
    color: "#8b949e"
  },
  {
    name: "Gmail",
    url: "https://mail.google.com",
    desc: "Correo electrónico.",
    cat: "Correo",
    icon: "✉",
    color: "#EA4335"
  },
  {
    name: "Dashboard",
    url: "#",
    desc: "Panel interno (pendiente de configurar).",
    cat: "Interno",
    icon: "📊",
    color: "#38bdf8"
  },
  {
    name: "Portal de acceso",
    url: "#",
    desc: "Portal con credenciales (pendiente de configurar).",
    cat: "Interno",
    icon: "🔑",
    color: "#fbbf24"
  }
];

/* ---- No editar a partir de aquí ---- */
const grid = document.getElementById("grid");
const empty = document.getElementById("empty");
const countEl = document.getElementById("count");
const searchEl = document.getElementById("search");
const filtersEl = document.getElementById("filters");
let activo = "Todos";

document.getElementById("year").textContent = new Date().getFullYear();

function categorias() {
  return ["Todos", ...new Set(DESTINOS.map(d => d.cat || "Otros"))];
}

function pintarFiltros() {
  filtersEl.innerHTML = "";
  categorias().forEach(cat => {
    const b = document.createElement("button");
    b.className = "chip" + (cat === activo ? " active" : "");
    b.textContent = cat;
    b.onclick = () => { activo = cat; pintarFiltros(); pintar(); };
    filtersEl.appendChild(b);
  });
}

function pintar() {
  const q = searchEl.value.trim().toLowerCase();
  const lista = DESTINOS.filter(d => {
    const okCat = activo === "Todos" || (d.cat || "Otros") === activo;
    const okTxt = !q || (d.name + " " + d.desc + " " + d.cat).toLowerCase().includes(q);
    return okCat && okTxt;
  });

  grid.innerHTML = "";
  lista.forEach(d => {
    const a = document.createElement("a");
    a.className = "card";
    a.href = d.url;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.innerHTML = `
      <div class="card-top">
        <div class="icon" style="background:${d.color}">${d.icon}</div>
        <h3>${d.name}</h3>
      </div>
      <p>${d.desc}</p>
      <div class="card-foot">
        <span class="tag">${d.cat || "Otros"}</span>
        <span class="go">Abrir →</span>
      </div>`;
    grid.appendChild(a);
  });

  empty.style.display = lista.length ? "none" : "block";
  countEl.textContent = `${lista.length} de ${DESTINOS.length} destinos`;
}

searchEl.addEventListener("input", pintar);
pintarFiltros();
pintar();
</script>
</body>
</html>
